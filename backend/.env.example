# Copiar para backend/.env e preencher o que se for usar.
# Tudo é opcional: sem uma chave, a parte da app que precisa dela fica desligada
# e o resto continua a funcionar.
#
# As linhas comentadas têm valor por omissão no código. Só se descomentam para
# mudar esse valor — uma variável definida mas vazia ganha ao valor por omissão.


# ── Base de dados e ficheiros ────────────────────────────────────────────
DATABASE_URL=sqlite:///./cristopher.db
UPLOADS_DIR=uploads
# Build do frontend servido pelo próprio backend (só na imagem da NAS).
# STATIC_DIR=


# ── Login ────────────────────────────────────────────────────────────────
# Sem password não há login (uso local). Aberta à internet é obrigatória, e com
# ela o JWT_SECRET também — senão a app não arranca.
CRISTOPHER_PASSWORD=
JWT_SECRET=

# CORS: origens extra separadas por vírgula. Vazio = só localhost e Tailscale.
ALLOWED_ORIGINS=

# Token partilhado com o agente do Mac e com o Atalho do iOS (captura rápida).
INGEST_TOKEN=


# ── IA ───────────────────────────────────────────────────────────────────
# Três degraus, por esta ordem: agente principal → agente de reserva → Ollama.
# Qualquer erro de um passa ao seguinte.
AI_API_KEY=
# AI_API_URL=
# AI_CHANNEL_ID=

FALLBACK_AI_API_KEY=
# FALLBACK_AI_API_URL=
# FALLBACK_AI_CHANNEL_ID=

# Modelo local (Ollama). Sem ele a correr, a app usa os agentes. 0 desliga.
LOCAL_AI=1
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:9b
# Abaixo disto o Ollama corta o prompt sem avisar.
# OLLAMA_NUM_CTX=32768
# Segundos que se espera pelo modelo local antes de desistir.
# AI_LOCAL_TIMEOUT=60


# ── Mac ──────────────────────────────────────────────────────────────────
# 1 = desliga o que só existe no Mac (tracker, Screen Time, Reminders,
# Calendário da Apple, LoL ao vivo). Usado na NAS.
# CLOUD=0

# Arranca o tracker de apps junto com o backend (só em macOS).
TRACKER_AUTOSTART=1


# ── Avisos ───────────────────────────────────────────────────────────────
# Web Push para o telemóvel. As chaves geram-se sozinhas na primeira vez.
# PUSH_KEYS_DIR=
# PUSH_CONTACT=mailto:cristopher@localhost

# Telegram (opcional).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 0 desliga os avisos de eventos / os empurrões ao longo do dia.
# EVENT_NOTIFY=1
# NOTIFY_NUDGES=1


# ── Cópias de segurança ──────────────────────────────────────────────────
# Por omissão ficam em ~/Library/Application Support/Cristopher/backups.
# BACKUP_DIR=
BACKUP_KEEP_DAYS=30
# Cópia cifrada para fora do Mac (ex: pasta do iCloud). Sem a frase não se envia
# nada — e se a frase se perder, essa cópia deixa de abrir.
BACKUP_OFFSITE_DIR=
BACKUP_PASSPHRASE=


# ── Banco (Enable Banking) ───────────────────────────────────────────────
# enablebanking.com/cp, aplicação em Production. Passos no README.
ENABLEBANKING_APP_ID=
ENABLEBANKING_KEY_PATH=enablebanking.pem
# Para onde o banco devolve depois de autorizar (tem de ser https e estar
# registado no painel). O callback_https.py serve isto em localhost.
# BANK_REDIRECT_URL=https://localhost:3043/expenses
# BANK_CALLBACK_PORT=3043
# BANK_CALLBACK_TARGET=http://localhost:3001


# ── Investimentos ────────────────────────────────────────────────────────
# Fundamentais e resultados trimestrais. Links em scripts/SETUP_KEYS.md.
FMP_API_KEY=
FINNHUB_API_KEY=
# Trading 212: Definições → API → gerar chave. Formato chave:segredo.
# Sem isto, as posições vêm dos extractos em PDF.
T212_API_KEY=


# ── Relógio Garmin ───────────────────────────────────────────────────────
# A password nunca vem daqui. Login uma vez à mão:
#   python scripts/garmin_login.py
# O backend só lê o token. Repetir logins bloqueia a conta 48h.
GARMIN_SYNC=1
# GARMIN_TOKENS_DIR=~/.garminconnect


# ── LoL ──────────────────────────────────────────────────────────────────
# developer.riotgames.com (a chave de developer dura 24h).
RIOT_API_KEY=
# O teu Riot ID (nome#tag). Os scripts preenche_*_lol.py precisam dele.
# RIOT_GAME_NAME=
# RIOT_TAG_LINE=


# ── Código ───────────────────────────────────────────────────────────────
# wakatime.com → Settings → API Key. Para Wakapi, mudar o URL.
WAKATIME_API_KEY=
# WAKATIME_API_URL=https://wakatime.com/api/v1


# ── Deals ────────────────────────────────────────────────────────────────
DEALS_AUTOSCAN=1
DEALS_SCAN_INTERVAL_HOURS=12
# Cidade do Facebook Marketplace (raio de ~100 km).
# FB_MARKETPLACE_CITY=lisbon
